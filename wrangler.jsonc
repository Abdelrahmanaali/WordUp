{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"wordup",
  "main":"src/index.js",
  "compatibility_date":"2026-09-17",
  "workers_dev": true,
  "assets":{"directory":"./public","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*","/ws/*"]},
  "durable_objects":{"bindings":[{"name":"GAME_ROOMS","class_name":"GameRoom"}]},
  "d1_databases":[{"binding":"WORDUP_DB","database_name":"wordup-db","database_id":"4a0fc582-a75c-463e-88b1-e347c771e137"}],
  "migrations":[{"tag":"v1","new_sqlite_classes":["GameRoom"]}]
}
